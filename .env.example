# ===== 千炼 (MaaS) 网关 =====
# 留空 = Mock 模式（可演示流程，但识别结果是假的）
# install 脚本会把真实 Key 写进 .env，本文件只是模板，不会被修改
MAAS_API_KEY=
MAAS_BASE_URL=https://ws-8cl1ej8elduuovea.cn-beijing.maas.aliyuncs.com/compatible-mode/v1

# ===== 模型 =====
# 主力视觉判定模型 / 读表 OCR 模型 / 文本模型（判级与写单用，MVP 默认不用）
MAAS_VISION_MODEL=qwen3-vl-plus
MAAS_OCR_MODEL=qwen-vl-ocr
MAAS_TEXT_MODEL=qwen3.8-flash

# ===== 运行模式 =====
# online | degraded | offline | airgap
NETWORK_MODE=online

# ===== 45 项试点 =====
# true：启用 config/pilot_check_items.yaml 里的 CI-06/CI-11（单帧 9 次调用）
# false：回到旧 4 类视觉检测
CHECK_ITEMS_PILOT=true

# ===== 判定阈值 =====
# 低于 conf_drop 直接丢弃；conf_drop~conf_review 之间转人工；高于 conf_review 仍需人工确认
CONF_DROP=0.45
CONF_REVIEW=0.75

# ===== 请求 =====
REQUEST_TIMEOUT_S=90
MAX_RETRIES=2
